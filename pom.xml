<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      ============================================================================
      PATCHED BUILD — REMEDIATED AGAINST BROADCOM SPRING ENTERPRISE
      ============================================================================
      This is the remediated counterpart of the intentionally-vulnerable build.
      Every CVE from the vulnerable dashboard is closed here:

        * Spring-owned CVEs (Spring4Shell, Spring Security bypass, SpEL DoS,
          actuator, Spring Cloud Function SpEL) are fixed by moving to the
          Spring Boot 2.7.33 ENTERPRISE patch line, which has exited OSS support
          on Maven Central and resolves ONLY from the Broadcom Spring Enterprise
          repository (packages.broadcom.com/artifactory/tanzu-maven).
        * The remaining pinned libraries are bumped to their fixed versions.

      Requires ~/.m2/settings.xml configured for the tanzu-maven repository and
      the TANZU_USER / TANZU_TOKEN environment variables at build time.
      ============================================================================
    -->

    <!-- ENTERPRISE patch release: past OSS EOL, served from tanzu-maven.
         Brings Spring Framework 5.3.31 (Spring4Shell fixed in 5.3.18),
         Spring Security 5.7.x (CVE-2022-22978 fixed in 5.6.4),
         and patched jackson / H2 via the Boot dependency BOM. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.33</version>
        <relativePath/>
    </parent>

    <groupId>com.broadcom.vulndemo</groupId>
    <artifactId>tanzu-vuln-demo</artifactId>
    <version>1.0.0-PATCHED</version>
    <name>Tanzu Vulnerability Demo (Patched)</name>
    <description>Remediated Spring Boot app — CVEs closed via Broadcom Spring Enterprise</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- CVE-2021-44228 / CVE-2021-45046: Log4Shell fixed in 2.17.1 -->
        <log4j2.version>2.17.1</log4j2.version>
        <!-- CVE-2022-1471: SnakeYAML constructor RCE fixed in 2.0 -->
        <snakeyaml.version>2.0</snakeyaml.version>
    </properties>

    <dependencies>
        <!-- Web + Thymeleaf for the dashboard -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Actuator: patched in Boot 2.7.33 (CVE-2023-20873 fixed in 2.7.11) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Security 5.7.x via Boot 2.7.33 (CVE-2022-22978 fixed in 5.6.4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ===================== PATCHED DEPENDENCIES ===================== -->

        <!-- CVE-2022-22963 fixed: Spring Cloud Function 3.2.9 (via 2021.0.9 BOM) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-function-web</artifactId>
        </dependency>

        <!-- CVE-2021-44228 / CVE-2021-45046 fixed: log4j-core 2.17.1
             (spring-boot-dependencies also manages log4j2.version above) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- CVE-2022-42889 fixed: commons-text 1.10.0 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.10.0</version>
        </dependency>

        <!-- CVE-2015-6420 fixed: commons-collections 3.2.2 -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.2</version>
        </dependency>

        <!-- CVE-2022-1471 fixed: SnakeYAML 2.0 (snakeyaml.version property) -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- CVE-2020-36518 fixed: jackson-databind managed by Boot 2.7.33 (2.13.5) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- CVE-2021-42392 / CVE-2022-23221 fixed: H2 2.1.214 managed by Boot 2.7.33 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- 2021.0.9 manages spring-cloud-function 3.2.9 (CVE-2022-22963 fixed in 3.2.3) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2021.0.9</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
